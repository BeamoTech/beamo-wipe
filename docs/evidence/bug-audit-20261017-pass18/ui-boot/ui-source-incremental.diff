     def _on_variable(self, *_args) -> None:
         self._sync()
         self._paint()
+
+    def _retire_variable_trace(self, event) -> None:
+        if event.widget is not self or self._variable_trace is None:
+            return
+        token = self._variable_trace
+        self._variable_trace = None
+        try:
+            # Variable callbacks outlive widgets unless explicitly removed.
+            # Keep other rows and independent observers on this variable.
+            self._variable.trace_remove("write", token)
+        except tk.TclError:
+            # Interpreter teardown may already have removed the variable.
+            pass
 
