+def _unresolved_identity_overlaps_protected(
+    boot: Optional[Disk], disks: Sequence[Disk],
+    physical_observations: Sequence[Disk],
+    unresolved: Sequence[_UnresolvedPhysicalIdentity],
+) -> bool:
