    "System manufacturer",
    "System Product Name",
    "Default string",
    "OEM",
    "O.E.M.",
    "Not Applicable",
    "Not Specified",
    "Unknown",
    "None",
    "Manufacturer",
    "Default"
  ],
  "words": {
    "en": {"or": " or ", "then": ", then ", "lead": "Typical keys (examples only):", "launcher_hint": "Most {brand} computers: press {keys} at power-on."},
    "fr": {"or": " ou ", "then": ", puis ", "lead": "Touches habituelles (exemples seulement) :"},
    "de": {"or": " oder ", "then": ", dann ", "lead": "Typische Tasten (nur Beispiele):"},
    "es": {"or": " o ", "then": " y luego ", "lead": "Teclas habituales (solo ejemplos):"},
    "it": {"or": " o ", "then": ", poi ", "lead": "Tasti più comuni (solo esempi):"}
