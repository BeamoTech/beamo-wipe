    {
      "id": "acer",
      "name": "Acer",
      "match": ["acer"],
      "keys": ["F12"],
      "join": "or",
      "note": "On many Acer models the F12 boot menu must first be turned on in firmware setup. That is a firmware change: confirm you can reach the BitLocker recovery key first, or use the Windows steps instead.",
      "launcher": true,
      "sources": ["https://community.acer.com/en/kb/articles/563-why-cant-i-get-the-f12-boot-menu-to-work-on-my-notebook-or-netbook"]
    },
    {
      "id": "msi",
      "name": "MSI",
      "match": ["micro star", "msi"],
      "keys": ["F11"],
      "join": "or",
      "launcher": true,
