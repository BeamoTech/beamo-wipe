    {
      "id": "lenovo",
      "name": "Lenovo",
      "match": ["lenovo"],
      "keys": ["F12"],
      "join": "or",
      "note": "Many Lenovo laptops need Fn+F12, or the small Novo button or pinhole (press it while the laptop is off, then choose the boot menu).",
      "launcher": true,
      "sources": ["https://support.lenovo.com/us/en/solutions/ht500207"]
    },
    {
      "id": "asus",
      "name": "ASUS",
      "match": ["asustek", "asus"],
      "keys": ["Esc", "F8"],
      "join": "or",
      "note": "ASUS laptops usually use Esc; ASUS desktop motherboards usually use F8.",
      "launcher": true,
      "sources": ["https://www.asus.com/support/faq/1013017/"]
