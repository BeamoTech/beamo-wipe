# Beamo Wipe live image — keep this small. No desktop, no browser, no network manager.
# Compilers and git are installed only in the nwipe build hook, then purged.
live-boot
live-config
live-config-systemd
linux-image-amd64
shim-signed
grub-efi-amd64-signed
systemd-sysv
python3
python3-tk
python3-gi
# QR matrix for the support code on error screens (pure Python use only).
python3-qrcode
gir1.2-gtk-3.0
librsvg2-common
at-spi2-core
dbus-x11
orca
speech-dispatcher-espeak-ng
# CLI only for the kiosk's pre-X spoken startup cue; Orca speaks via speech-dispatcher.
espeak-ng
speech-dispatcher
pulseaudio
# pactl for the accessible Sound check (output choice, volume, mute).
pulseaudio-utils
python3-minimal
xserver-xorg
xserver-xorg-core
xserver-xorg-video-vesa
xserver-xorg-video-fbdev
xserver-xorg-video-vmware
xserver-xorg-video-qxl
xserver-xorg-video-intel
xserver-xorg-video-nouveau
xserver-xorg-video-amdgpu
xserver-xorg-video-radeon
xserver-xorg-input-libinput
xinit
x11-xserver-utils
tk
# The wizard UI is designed on DejaVu (see ui/tk_wizard.py _family). With
# recommends off, no X font is guaranteed otherwise and Tk would fall back
# to the X server's unscalable built-in "fixed" bitmap font.
fonts-dejavu-core
util-linux
# Recovery refuses power actions while nwipe is running or the check fails.
procps
smartmontools
# nwipe v0.42 uses hdparm only for read-only HPA/DCO discovery. It is kept as
# an engine dependency; Beamo never constructs ATA security-erase arguments.
hdparm
ca-certificates
kbd
console-setup
# Console keymaps for loadkeys (kbd ships none). Without them the text-console
# guide and recovery menu stay US QWERTY whatever layout the owner chooses.
console-data
# Hardware support (non-free-firmware). Only what makes screens and audio
# work on more PCs; no Wi-Fi or Bluetooth firmware package (misc-nonfree
# still carries a few old radio chip files; nothing here connects). Graphics and
# misc firmware come from bookworm-backports with the 6.12 kernel
# (config/archives/backports.pref.chroot); SOF and microcode from bookworm.
firmware-amd-graphics
firmware-intel-graphics
firmware-nvidia-graphics
# TI laptop speaker amplifiers and other small device firmware.
firmware-misc-nonfree
firmware-intel-misc
# Laptop audio: Intel SOF/HDA DSPs and Cirrus amplifiers (spoken startup, Orca).
# bookworm's SOF 2.2.4 predates Meteor Lake (IPC4); no backport exists.
firmware-sof-signed
firmware-intel-sound
firmware-cirrus
# CPU microcode, loaded early by the initramfs.
intel-microcode
amd64-microcode
libncurses6
libparted2
libconfig9
