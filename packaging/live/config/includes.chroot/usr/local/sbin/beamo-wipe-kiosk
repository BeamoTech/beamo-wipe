#!/bin/sh
# systemd kiosk supervisor. It never starts a login shell.
set -eu
umask 077
export HOME=/root
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export XAUTHORITY=/tmp/beamo-wipe-xauthority

stty susp undef 2>/dev/null || true
stty quit undef 2>/dev/null || true
stty intr undef 2>/dev/null || true
trap 'exit 0' TERM HUP
trap '' TSTP INT QUIT

boot_ui_mode() {
  set -f
  # shellcheck disable=SC2013,SC2046
  for word in $(cat "$1" 2>/dev/null); do
    case "$word" in
      beamo.ui=accessible) printf '%s\n' accessible; return 0 ;;
    esac
  done
  return 0
}

UI_MODE="$(boot_ui_mode /proc/cmdline)"

boot_has_word() {
  set -f
  # shellcheck disable=SC2013,SC2046
  for word in $(cat /proc/cmdline 2>/dev/null); do
    [ "$word" = "$1" ] && return 0
  done
  return 1
}

say() { [ "$UI_MODE" = accessible ] || return 0; command -v espeak-ng >/dev/null 2>&1 || return 0; timeout 15 espeak-ng -- "$1" >/dev/null 2>&1 || true; }

# QEMU's boot gate waits for this marker from the shipped live filesystem.
# It is harmless on physical machines without a serial console.
if [ -c /dev/ttyS0 ]; then
  printf '%s\n' BEAMO_WIPE_KIOSK_READY >/dev/ttyS0 2>/dev/null || true
  # Read-only evidence of firmware enforcement, independent of the ISO label.
  sb_file=/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c
  if [ -r "$sb_file" ]; then
    sb_value="$(od -An -tu1 -j4 -N1 "$sb_file" 2>/dev/null | tr -d '[:space:]')"
    case "$sb_value" in
      0|1) printf 'BEAMO_WIPE_SECURE_BOOT=%s\n' "$sb_value" >/dev/ttyS0 2>/dev/null || true ;;
    esac
  fi
  if [ "$UI_MODE" = accessible ]; then
    printf '%s\n' BEAMO_WIPE_UI_MODE=accessible >/dev/ttyS0 2>/dev/null || true
  fi
  # The troubleshoot entry's safe video settings, for the QEMU boot gate.
  if boot_has_word nomodeset; then
    printf '%s\n' BEAMO_WIPE_SAFE_VIDEO=1 >/dev/ttyS0 2>/dev/null || true
  fi
fi

# These fixed status values survive failed imports and X startup.
graphical_rc=not-run
console_rc=not-run

run_console() {
  console_rc=0
  BEAMO_WIPE_GRAPHICAL_UNAVAILABLE=1 /usr/local/bin/beamo-wipe --console || console_rc=$?
  return "$console_rc"
}

# Fixed, identifier-free classification of a failed X start for the QEMU
# gate: which display devices exist and which known X error was logged.
# No log text, device name or hardware detail is ever printed.
graphical_diagnostics() {
  if [ -e /dev/fb0 ]; then echo BEAMO_WIPE_X_FB0=1; else echo BEAMO_WIPE_X_FB0=0; fi
  if [ -e /dev/dri/card0 ]; then echo BEAMO_WIPE_X_DRI=1; else echo BEAMO_WIPE_X_DRI=0; fi
  x_log=""
  for candidate in /var/log/Xorg.0.log /root/.local/share/xorg/Xorg.0.log; do
    if [ -r "$candidate" ]; then x_log="$candidate"; break; fi
  done
  if [ -z "$x_log" ]; then
    echo BEAMO_WIPE_X_LOG_MISSING
    return 0
  fi
  grep -q 'no screens found' "$x_log" && echo BEAMO_WIPE_X_NO_SCREENS
  grep -q 'No devices detected' "$x_log" && echo BEAMO_WIPE_X_NO_DEVICES
  grep -q '(EE) modeset' "$x_log" && echo BEAMO_WIPE_X_MODESET_ERROR
  grep -q '(EE) FBDEV' "$x_log" && echo BEAMO_WIPE_X_FBDEV_ERROR
  grep -q 'Unable to find a valid framebuffer device' "$x_log" && echo BEAMO_WIPE_X_FB_NOT_FOUND
  # Each fixed fbdev/fbdevhw (Xorg 21.1.7, fbdev 0.5.0) failure class.
  grep -q 'Failed to open framebuffer device' "$x_log" && echo BEAMO_WIPE_X_FB_OPEN_FAILED
  grep -q 'FBIOGET_[FV]SCREENINFO' "$x_log" && echo BEAMO_WIPE_X_FB_GET_INFO_FAILED
  grep -q 'FBIOPUT_VSCREENINFO: ' "$x_log" && echo BEAMO_WIPE_X_FB_PUT_VAR_FAILED
  grep -q 'FBIOPUT_VSCREENINFO succeeded but modified' "$x_log" && echo BEAMO_WIPE_X_FB_MODE_MODIFIED
  grep -q 'mode initialization failed' "$x_log" && echo BEAMO_WIPE_X_FB_MODE_INIT_FAILED
  grep -q 'mmap fbmem\|mapping of video memory' "$x_log" && echo BEAMO_WIPE_X_FB_MMAP_FAILED
  grep -q 'bits per pixel\|not supported at depth\|pixmap depth setup failed' "$x_log" &&
    echo BEAMO_WIPE_X_FB_DEPTH_UNSUPPORTED
  grep -q 'shadow framebuffer' "$x_log" && echo BEAMO_WIPE_X_FB_SHADOW_FAILED
  grep -q 'visual type setup failed\|miCreateDefColormap failed' "$x_log" &&
    echo BEAMO_WIPE_X_FB_VISUAL_FAILED
  grep -q 'not yet supported\|text mode is not supported\|unrecognised' "$x_log" &&
    echo BEAMO_WIPE_X_FB_TYPE_UNSUPPORTED
  grep -q 'AddScreen/ScreenInit failed' "$x_log" && echo BEAMO_WIPE_X_SCREEN_INIT_FAILED
  grep -q 'none have a usable configuration' "$x_log" && echo BEAMO_WIPE_X_NO_USABLE_SCREEN
  grep -q '(EE) VESA' "$x_log" && echo BEAMO_WIPE_X_VESA_ERROR
  grep -q 'Failed to load module' "$x_log" && echo BEAMO_WIPE_X_MODULE_MISSING
  grep -q 'Fatal server error' "$x_log" && echo BEAMO_WIPE_X_FATAL
  qemu_x_details "$x_log"
  return 0
}

# QEMU gate only. A virtual machine whose firmware names itself QEMU (never
# a customer PC) also sends the X server's fbdev mode lines and the kernel
# framebuffer geometry, printable ASCII only, so a mode mismatch can be
# named from the gate's private serial evidence.
qemu_x_details() {
  [ "$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null)" = QEMU ] || return 0
  grep -a 'FBDEV(0)\|Modeline\|(EE)' "$1" 2>/dev/null | tr -cd '\11\12\40-\176' |
    head -n 80 | sed 's/^/BEAMO_WIPE_QEMU_X_LOG /'
  for fb in /sys/bus/platform/devices/*/graphics/fb0; do
    [ -d "$fb" ] || continue
    for attr in name virtual_size bits_per_pixel stride mode modes; do
      printf 'BEAMO_WIPE_QEMU_FB %s=%s\n' "$attr" "$(tr -cd '\40-\176' <"$fb/$attr" 2>/dev/null)"
    done
  done
  return 0
}

# Safe video on UEFI: nomodeset leaves the firmware framebuffer (/dev/fb0)
# and no DRM device. X's autodetection then tried only vesa, which cannot
# work without a legacy video BIOS, and found no screens (QEMU OVMF, CI
# run 41237147966). Point X at the framebuffer in exactly that case with
# the shipped /etc/X11/beamo-safe-video.conf (relative -config names are
# searched in /etc/X11; xorg.conf.d still applies). Nothing is written at
# runtime: this service runs with ProtectSystem=full, so /etc is read-only
# (CI run 41255192420). BIOS safe video has no framebuffer and keeps vesa;
# normal boots use KMS.
SAFE_VIDEO_X_CONFIG=beamo-safe-video.conf
safe_video_x_config() {
  boot_has_word nomodeset || return 0
  [ -e /dev/fb0 ] || return 0
  [ -e /dev/dri/card0 ] && return 0
  printf '%s\n' "$SAFE_VIDEO_X_CONFIG"
}

# Linux 6.9+ (here 6.12) parents the firmware framebuffer device to the
# PCI display it scans out from, so /sys/class/graphics/fb0 resolves under
# devices/pci. Bookworm's Xorg 21.1.7 fbdev helper then refuses fb0 on its
# non-PCI path and finds no fb directly under the PCI device on its PCI
# path, so X has no screen whenever no DRM driver is bound (UEFI safe video,
# or a GPU without a working driver; vesa cannot help without a legacy
# video BIOS). Later Xorg 21.1 releases (Debian 13) decide by the device's
# bus instead. In this service's private mount namespace only
# (PrivateMounts=yes), give X the class link that rule would accept, and
# only for a firmware framebuffer on the platform bus. Discovery, the host
# and other sessions never see it.
FIRMWARE_FB_LINK=../../devices/platform/beamo-firmware-framebuffer/graphics/fb0
firmware_fb_for_x() {
  [ -e /dev/fb0 ] || return 0
  [ -e /dev/dri/card0 ] && return 0
  link="$(readlink /sys/class/graphics/fb0 2>/dev/null)" || return 0
  case "$link" in */devices/pci*) ;; *) return 0 ;; esac
  bus="$(readlink /sys/class/graphics/fb0/device/subsystem 2>/dev/null)" || return 0
  case "$bus" in */bus/platform) ;; *) return 0 ;; esac
  mount -t tmpfs -o mode=0755,size=64k,nosuid,nodev,noexec beamo-graphics \
    /sys/class/graphics 2>/dev/null || return 0
  ln -s "$FIRMWARE_FB_LINK" /sys/class/graphics/fb0 2>/dev/null || true
}

run_ui() {
  rm -f /tmp/.X11-unix/X0 /tmp/.X0-lock "$XAUTHORITY" 2>/dev/null || true
  x_config="$(safe_video_x_config)"
  firmware_fb_for_x
  say "Beamo Wipe is starting with speech. No new erase starts automatically."
  if command -v startx >/dev/null 2>&1; then
    graphical_rc=0
    if [ "$UI_MODE" = accessible ]; then
      startx /usr/local/bin/beamo-wipe --accessible -- -nolisten tcp vt1 ${x_config:+-config "$x_config"} || graphical_rc=$?
    else
      startx /usr/local/bin/beamo-wipe -- -nolisten tcp vt1 ${x_config:+-config "$x_config"} || graphical_rc=$?
    fi
    rm -f /tmp/.X11-unix/X0 /tmp/.X0-lock "$XAUTHORITY" 2>/dev/null || true
    if [ "$graphical_rc" -eq 0 ]; then
      return 0
    fi
  else
    graphical_rc=127
  fi
  # Fixed, identifier-free marker for the QEMU gate: the graphical guide did
  # not run and the keyboard text screens follow (harmless without serial).
  if [ -c /dev/ttyS0 ]; then
    printf '%s\n' BEAMO_WIPE_GRAPHICAL_FAILED >/dev/ttyS0 2>/dev/null || true
    graphical_diagnostics >/dev/ttyS0 2>/dev/null || true
  fi
  say "The spoken screen could not start. A keyboard text screen is showing instead. Speech is not available on it."
  run_console
}

clear_screen() {
  # A crashed curses session may leave raw input, hidden cursor or attributes.
  stty sane 2>/dev/null || true
  stty susp undef quit undef intr undef 2>/dev/null || true
  printf '\033[0m\033[?25h\033[?1049l\033[2J\033[H'
}

recovery_menu() {
  clear_screen
  printf '%s\n' '' \
    'Beamo Wipe recovery' \
    "$recovery_reason" \
    'An earlier erase may still be running or may be incomplete.' \
    'This screen cannot identify disks or confirm an erase result.' \
    'Keep all disks connected. Retrying does not start a new erase.' \
    '' \
    '1  Try Beamo Wipe again' \
    '2  Use keyboard text screens' \
    '3  Technical details and logs' \
    '4  Restart computer' \
    '5  Shut down'
  say "Beamo Wipe recovery. $recovery_reason"
  say 'An earlier erase may still be running or may be incomplete. Keep disks connected.'
  say '1: Try Beamo Wipe again. 2: Use keyboard text screens. 3: Technical details and logs.'
  say '4: Restart computer. 5: Shut down. Type a number, then press Enter.'
}

notice() {
  printf '%s\n' "$1"
  say "$1"
}

short_choices() {
  notice '1 Retry  2 Text screens  3 Details  4 Restart  5 Shut down'
}

read_choice() {
  if ! IFS= read -r choice; then
    if [ "$input_failure_count" -eq 0 ]; then
      notice 'Input is unavailable. Recovery stays here; no automatic retry.'
    fi
    # Ctrl-D can produce one EOF on a live tty while the terminal remains
    # usable. Keep checking for input, but bound visible output and back off
    # if the tty keeps failing so the recovery message remains readable.
    if [ -t 0 ]; then
      if [ "$input_failure_count" -lt 3 ]; then
        input_failure_count=$((input_failure_count + 1))
        if [ "$input_failure_count" -eq 3 ]; then
          notice 'Input remains unavailable. Recovery stays on this screen; try another keyboard or USB port.'
        fi
      fi
      if [ "$input_failure_count" -eq 3 ]; then sleep 5 || true; else sleep 1 || true; fi
      return 1
    fi
    # A closed pipe cannot regain input. Preserve the recovery text.
    exit 0
  fi
  input_failure_count=0
}

power_choice() {
  clear_screen
  notice 'An earlier erase may still be running or may be incomplete.'
  case "$1" in
    reboot) token=RESTART ;;
    poweroff) token=SHUTDOWN ;;
    *) return ;;
  esac
  notice 'Restarting or shutting down loses unsaved reports and temporary logs.'
  notice "Type $token to confirm, or press Enter to cancel."
  if ! read_choice; then
    notice 'Cancelled. The computer will stay on.'
    return
  fi
  if [ "$choice" != "$token" ]; then
    notice 'Cancelled. The computer will stay on.'
    return
  fi
  # A crashed UI can leave the pinned nwipe process alive. Never power off
  # on an uncertain process check, including a missing/broken procps tool.
  engine_rc=0
  pgrep -x nwipe >/dev/null 2>&1 || engine_rc=$?
  if [ "$engine_rc" -ne 1 ]; then
    notice 'We cannot confirm that erasing has stopped. Power request blocked.'
    notice 'Try Beamo Wipe again to review and stop an interrupted erase.'
    return
  fi
  if systemctl --no-block "$1"; then
    notice 'Power request accepted. Wait for the computer to finish.'
  else
    notice 'The power request failed. Recovery is still available.'
  fi
}

# One budget for this supervisor lifetime. A normal UI exit is not a failure;
# return to the menu immediately. Manual attempts never refill the budget.
attempt=0
recovery_reason='Automatic retries have stopped after 3 failed attempts.'
while [ "$attempt" -lt 3 ]; do
  attempt=$((attempt + 1))
  if run_ui; then
    recovery_reason='Beamo Wipe has closed. Choose what to do next.'
    break
  fi
  if [ "$attempt" -lt 3 ]; then sleep 1 || true; fi
done

input_failure_count=0
recovery_menu
while :; do
  if [ "$input_failure_count" -eq 0 ]; then
    printf '%s\n' 'Choose 1, 2, 3, 4 or 5, then press Enter:'
  fi
  if ! read_choice; then continue; fi
  case "$choice" in
    1)
      run_ui || true
      recovery_reason='The retry has ended. Automatic retries remain stopped.'
      recovery_menu
      ;;
    2)
      run_console || true
      recovery_reason='The text screen has closed. Automatic retries remain stopped.'
      recovery_menu
      ;;
    3)
      clear_screen
      notice 'Beamo Wipe recovery: technical details'
      notice "Automatic attempts used: $attempt of 3"
      notice "Graphical exit code: $graphical_rc"
      notice "Text screen exit code: $console_rc"
      notice 'Code 127 means a required command could not be found.'
      if [ -d /tmp/beamo-wipe ] && [ ! -L /tmp/beamo-wipe ] && [ -r /tmp/beamo-wipe ]; then
        notice 'Application log folder: /tmp/beamo-wipe/'
        notice 'Files may be incomplete. No log proves that an erase succeeded.'
      else
        notice 'Application log folder is not available.'
      fi
      notice 'These details are temporary. Note them before restarting.'
      short_choices
      ;;
    4) power_choice reboot; short_choices ;;
    5) power_choice poweroff; short_choices ;;
    *) recovery_menu; notice 'Choose 1, 2, 3, 4 or 5. Nothing was started.' ;;
  esac
done
